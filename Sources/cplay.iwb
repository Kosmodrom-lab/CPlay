TYPE BASS_DX8_COMPRESSOR
    FLOAT fGain        ' Gain compensation (-60 to +60 dB)
    FLOAT fAttack      ' Attack time (0.01 to 500 ms)
    FLOAT fRelease     ' Release time (50 to 3000 ms)
    FLOAT fThreshold   ' Threshold (-60 to 0 dB)
    FLOAT fRatio       ' Compression ratio (1:1 to 100:1)
    FLOAT fPredelay    ' Pre-delay (0 to 4 ms)
ENDTYPE

TYPE BASS_DX8_REVERB
    FLOAT fInGain          ' Input gain (-96 to 0 dB)
    FLOAT fReverbMix       ' Reverb mix (-96 to 0 dB)
    FLOAT fReverbTime      ' Reverb time (0.001 to 3000 ms)
    FLOAT fHighFreqRHRatio ' High frequency ratio (0.001 to 0.999)
ENDTYPE

